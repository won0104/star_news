  UNWIND [{nodeId: "00000024-0920-4000-8000-000000000001", canonicalName: "한국은행", entityType: "GOVERNMENT_AGENCY", aliases: ["한국은행", "한은"], createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000002", canonicalName: "미국 연방준비제도", entityType: "GOVERNMENT_AGENCY", aliases: ["연방준비제도", "연준"], createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000003", canonicalName: "산업통상자원부", entityType: "GOVERNMENT_AGENCY", aliases: ["산업통상자원부", "산업부"], createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000004", canonicalName: "과학기술정보통신부", entityType: "GOVERNMENT_AGENCY", aliases: ["과학기술정보통신부", "과기정통부"], createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000009", canonicalName: "보건복지부", entityType: "GOVERNMENT_AGENCY", aliases: ["보건복지부", "복지부"], createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}] AS row
