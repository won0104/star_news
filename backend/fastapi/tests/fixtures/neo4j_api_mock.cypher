CALL {
  UNWIND [{nodeId: "00000025-0920-4000-8000-000000000003", timeKey: "2024-01-11", value: "2024-01-11", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 1, day: 11}, {nodeId: "00000025-0920-4000-8000-000000000004", timeKey: "2024-01-15", value: "2024-01-15", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 1, day: 15}, {nodeId: "00000025-0920-4000-8000-000000000006", timeKey: "2024-02-06", value: "2024-02-06", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 2, day: 6}, {nodeId: "00000025-0920-4000-8000-000000000007", timeKey: "2024-02-20", value: "2024-02-20", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 2, day: 20}, {nodeId: "00000025-0920-4000-8000-000000000010", timeKey: "2024-04-16", value: "2024-04-16", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 4, day: 16}, {nodeId: "00000025-0920-4000-8000-000000000012", timeKey: "2024-05-24", value: "2024-05-24", granularity: "DAY", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 5, day: 24}] AS row
