  UNWIND [{nodeId: "00000022-0920-4000-8000-000000000001", title: "한미 통화정책과 외환시장 변화", lastEventAddedAt: datetime("2024-05-25T05:20:00+09:00"), createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000022-0920-4000-8000-000000000002", title: "AI 반도체 수요와 엔비디아 실적", lastEventAddedAt: datetime("2024-05-25T05:20:00+09:00"), createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000022-0920-4000-8000-000000000003", title: "HBM 공급 경쟁과 검사장비", lastEventAddedAt: datetime("2024-05-25T05:20:00+09:00"), createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000022-0920-4000-8000-000000000004", title: "의대 증원과 의료 현장 대응", lastEventAddedAt: datetime("2024-05-25T05:20:00+09:00"), createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000022-0920-4000-8000-000000000005", title: "국내 반도체 산업 지원 정책", lastEventAddedAt: datetime("2024-05-25T05:20:00+09:00"), createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}] AS row
