// 실제 뉴스 기반 API 검증용 고정 데이터 (모델 출력·골드 데이터 아님)
// 테스트 기준 시각: 2024-05-25 05:45:00 KST. 원문과 발행일은 2024년 그대로 보존.
// 실제 현재 시각을 쓰는 기간 필터/노출 제어는 다르게 보인다. 테스트 Clock을 위 시각으로 고정한다.
// 추천: 이 시각에는 2024-05-24 18:00 회차, 06:00 이후에는 2024-05-25 06:00 회차.
// 파일 두 개를 각각 초기 스키마만 적용된 별도 빈 로컬 DB에서 1회 실행한다.
// 기존 원본 전용 SQL/예전 목 데이터 위에 추가 실행하지 않는다. 기존 데이터 삭제 기능은 없다.
// 로그인: mock-api-1 / mock-api-2 / mock-api-3, 비밀번호 MockNews!2024 (BCrypt $2a$, cost 10).
// mock-api-4는 소프트 삭제된 계정이며 Neo4j User가 없다. 인증 인코더는 BCrypt 기준 테스트 가정.
// 기사 930001~930017: 분석 완료. 930018: 빈 본문/DROPPED, 930019: FAILED, 930020: PROCESSING.
// 기사 요약 930004=NOT_REQUESTED, 930010=PROCESSING, 930012=FAILED, 나머지 완료 기사=COMPLETED.
// 노드·관계·요약·분류·점수는 고정 목 값. 전체 본문에 대한 완전한 정보 추출 결과가 아니다.
// Event 벡터는 정규화한 테스트용 8차원. 실모델 벡터/Vector Index와 혼용하지 않는다.
// 정확한 사건 시각을 모르면 occurredAt을 채우지 않고 Time으로 날짜/월을 표현한다.
// 미국 현지일의 KST 날짜 오인을 피하기 위해 연준·엔비디아 사건은 월 정밀도로 둔다.
// Statement ABOUT은 본문이 다른 사건을 직접 평가하는 사례만 포함했다.
// 관심도 score=min(1,(고유 열람 기사+노드 클릭+즐겨찾기*2)/10), 명시 관심=1: 목 데이터 전용 공식.
// 트렌드: [기준시각-24h, 기준시각) 고유 기사 수, score=기사 수, 동률 고정 정렬, 직전 12h 회차와 비교.
// 요약·추천 알고리즘·인증 토큰·실제 AI 외부 호출은 이 데이터만으로 검증되지 않는다.
// 전체 적재는 단일 트랜잭션. 초기 Topic만 있는 경우에 한해 상호 참조 UUID를 고정한다.
// 초기 Topic 외 데이터/관계가 있으면 0 나눗셈 오류로 중단한다. 기존 데이터 삭제·교체는 하지 않는다.
CALL { MATCH (n) RETURN count(n) AS total, count(CASE WHEN n:Topic AND n.topicCode IN ["POLITICS", "ECONOMY", "SOCIETY", "CULTURE", "INTERNATIONAL", "SPORTS", "IT_SCIENCE"] THEN n END) AS seeds }
CALL { MATCH ()-[r]->() RETURN count(r) AS existingRelations }
WITH total, seeds, existingRelations WHERE 1 / CASE WHEN total=seeds AND total<=7 AND existingRelations=0 THEN 1 ELSE 0 END = 1
CALL {
  UNWIND [{nodeId: "00000024-0920-4000-8000-000000000101", canonicalName: "뉴스1", aliases: ["뉴스1"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940001, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000102", canonicalName: "머니S", aliases: ["머니S"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940002, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000103", canonicalName: "문화일보", aliases: ["문화일보"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940003, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000104", canonicalName: "블로터", aliases: ["블로터"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940004, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000105", canonicalName: "서울신문", aliases: ["서울신문"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940005, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000106", canonicalName: "세계일보", aliases: ["세계일보"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940006, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000107", canonicalName: "중앙일보", aliases: ["중앙일보"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940007, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000108", canonicalName: "KBS뉴스", aliases: ["KBS뉴스"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940008, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000109", canonicalName: "SBS뉴스", aliases: ["SBS뉴스"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940009, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000110", canonicalName: "디지털타임", aliases: ["디지털타임"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940010, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000111", canonicalName: "한국경제TV", aliases: ["한국경제TV"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940011, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000024-0920-4000-8000-000000000112", canonicalName: "코메디닷컴", aliases: ["코메디닷컴"], entityType: "NEWS_ORGANIZATION", mysqlOrganizationId: 940012, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}] AS row
  CREATE (n:Entity:NewsOrganization {nodeId: row.nodeId})
  SET n += row
  RETURN count(n) AS n0
}
CALL {
  UNWIND [{nodeId: "00000023-0920-4000-8000-000000000001", topicCode: "POLITICS", nameKo: "정치", displayOrder: 1, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000002", topicCode: "ECONOMY", nameKo: "경제", displayOrder: 2, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000003", topicCode: "SOCIETY", nameKo: "사회", displayOrder: 3, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000004", topicCode: "CULTURE", nameKo: "문화", displayOrder: 4, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000005", topicCode: "INTERNATIONAL", nameKo: "국제", displayOrder: 5, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000006", topicCode: "SPORTS", nameKo: "스포츠", displayOrder: 6, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}, {nodeId: "00000023-0920-4000-8000-000000000007", topicCode: "IT_SCIENCE", nameKo: "IT·과학", displayOrder: 7, isActive: true, createdAt: datetime("2024-01-01T00:00:00+09:00"), updatedAt: datetime("2024-05-25T05:20:00+09:00")}] AS row
  MERGE (n:Topic {topicCode: row.topicCode})
  SET n += row
  RETURN count(n) AS n1
}
