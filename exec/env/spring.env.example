DB_URL=jdbc:mysql://localhost:13306/mysqldb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=db-password

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=redis-password
NEO4J_URI=bolt://localhost:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j-password

JWT_SECRET=generate-a-random-secret-at-least-32-bytes

# 인증 저장소: memory(기본) | redis
APP_AUTH_STORE=redis

# GNews 기사 수집 (https://gnews.io)
GNEWS_API_KEY=your-gnews-api-key
GNEWS_MAX=100

# Spring Boot -> FastAPI 내부 호출 인증 (FastAPI 와 같은 값)
INTERNAL_API_KEY=your-internal-api-key
GMS_API_KEY=your-gms-api-key