  UNWIND [{nodeId: "00000025-0920-4000-8000-000000000002", timeKey: "2024-01", value: "2024-01", granularity: "MONTH", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 1}, {nodeId: "00000025-0920-4000-8000-000000000005", timeKey: "2024-02", value: "2024-02", granularity: "MONTH", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 2}, {nodeId: "00000025-0920-4000-8000-000000000008", timeKey: "2024-03", value: "2024-03", granularity: "MONTH", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 3}, {nodeId: "00000025-0920-4000-8000-000000000009", timeKey: "2024-04", value: "2024-04", granularity: "MONTH", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 4}, {nodeId: "00000025-0920-4000-8000-000000000011", timeKey: "2024-05", value: "2024-05", granularity: "MONTH", year: 2024, createdAt: datetime("2024-01-01T00:00:00+09:00"), month: 5}] AS row
